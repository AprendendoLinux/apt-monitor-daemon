#!/bin/sh
set -e

case "$1" in
remove|upgrade|deconfigure)
    if [ -d /run/systemd/system ]; then
        systemctl stop apt-monitor-plus.service >/dev/null 2>&1 || true
        # Só desabilita na remoção; em upgrade o postinst religa o serviço.
        if [ "$1" = "remove" ]; then
            systemctl disable apt-monitor-plus.service >/dev/null 2>&1 || true
        fi
    fi
    ;;
esac

exit 0
